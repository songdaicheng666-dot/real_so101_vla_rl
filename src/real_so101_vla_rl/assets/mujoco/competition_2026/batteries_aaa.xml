<mujocoinclude>
  <!--
    Shared AAA battery set for both Competition 2026 scenes.

    Dimensions and mass follow the Energizer E92 AAA datasheet:
    diameter 10.5 mm, total length 44.5 mm, typical mass 11.5 g.
    Each body is rotated -90 degrees around local x so its cylinder axis
    points along world +y when the including frame has no rotation.
  -->
  <body name="battery_red" pos="-0.214698 0.355914 0.00525"
        quat="0.70710678 -0.70710678 0 0">
    <freejoint name="battery_red_joint"/>
    <geom name="battery_red_collision" type="cylinder" size="0.00525 0.02225"
          mass="0.0115" condim="6" friction="0.8 0.005 0.0001"
          solref="0.01 1" solimp="0.95 0.99 0.001" group="3"
          rgba="0 0 0 0"/>
