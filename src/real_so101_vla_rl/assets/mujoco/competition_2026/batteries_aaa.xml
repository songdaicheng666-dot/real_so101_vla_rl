          mass="0" contype="0" conaffinity="0" group="2"
          rgba="0.780392 0.176471 0.113725 1"/>
    <geom name="battery_red_negative_terminal" type="cylinder"
          pos="0 0 -0.02155" size="0.0046 0.0007" mass="0"
          contype="0" conaffinity="0" group="2" rgba="0.72 0.74 0.78 1"/>
